# Never commit a real API key. Server-side only.
GROQ_API_KEY=gsk_replace_with_your_key
# Optional: enable OpenRouter fallback for answers (speech still requires Groq).
OPENROUTER_API_KEY=
# Optional: protect a public deployment with a PIN.
APP_PIN=change-this-before-deploying
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
OPENROUTER_MODEL=openrouter/free
