# Required for public deployment: long random secret; four digit PIN is NOT secure.
APP_PIN=replace-with-long-random-credential
# Transcription (free within Groq tier):
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# Optional answer backends; any configured paid API incurs usage charges:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# auto = OpenAI > Anthropic > Groq > OpenRouter if credentials exist.
ANSWER_PROVIDER=groq
# Set true to allow paid provider auto-fallback when primary fails.
ALLOW_PAID_FALLBACK=false
# Vercel: Required for distributed rate limiting (Upstash free tier is an option).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set by hosting platform; do not set NODE_ENV=production locally without access secret.
